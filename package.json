{
    "name": "manycord",
    "version": "0.1.1",
    "description": "A Vencord plugin that removes or customizes Discord's five-account switcher limit",
    "author": "zpt0.dev",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/zpt0/manycord.git"
    },
    "keywords": [
        "vencord",
        "discord",
        "plugin",
        "account-switcher",
        "userplugin"
    ],
    "type": "module",
    "private": true,
    "scripts": {
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@vitest/coverage-v8": "^5.1.1",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.10.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.73.0",
        "vitest": "^5.1.1"
    }
}
